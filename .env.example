# PayPal Config
PAYPAL_MODE=sandbox
PAYPAL_CLIENT_ID=YOUR_PAYPAL_CLIENT_ID
PAYPAL_CLIENT_SECRET=YOUR_PAYPAL_CLIENT_SECRET
PAYPAL_PLAN_ID=P-YOUR_PLAN_ID
PAYPAL_WEBHOOK_ID=YOUR_PAYPAL_WEBHOOK_ID

# Telegram Config
TELEGRAM_BOT_TOKEN=YOUR_TELEGRAM_BOT_TOKEN

# Server Config
PORT=3001
NODE_ENV=development
BASE_URL=https://yourdomain.com
ALLOWED_ORIGINS=https://yourdomain.com

# Database - MongoDB
MONGODB_URI_PAYMENTS=mongodb+srv://USER:PASS@cluster.mongodb.net/payments
MONGODB_URI_MBOTS=mongodb+srv://USER:PASS@cluster.mongodb.net/mbot

# Redis — requerido para BullMQ y cache distribuido
# Desarrollo: redis://localhost:6379
# Producción: redis://:PASSWORD@redis-host:6379/0
REDIS_URL=redis://localhost:6379

# Internal API key (generate with: openssl rand -hex 32)
EXTERNAL_API_KEY=GENERATE_WITH_openssl_rand_hex_32
