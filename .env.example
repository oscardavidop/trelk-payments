# ═══════════════════════════════════════════════════════
# .env.example — Copia a .env y completa con tus valores
# NUNCA commitear el .env real con credenciales
# ═══════════════════════════════════════════════════════

# ── Entorno ─────────────────────────────────────────────
NODE_ENV=development
APP_ENV=development
PORT=3001

# ── PayPal ──────────────────────────────────────────────
PAYPAL_MODE=sandbox
PAYPAL_CLIENT_ID=YOUR_PAYPAL_CLIENT_ID
PAYPAL_CLIENT_SECRET=YOUR_PAYPAL_CLIENT_SECRET
PAYPAL_PLAN_ID=P-YOUR_PLAN_ID
PAYPAL_WEBHOOK_ID=YOUR_PAYPAL_WEBHOOK_ID

# ── Telegram ────────────────────────────────────────────
TELEGRAM_BOT_TOKEN=123456789:ABCDEFGHIJKLMNOPQRSTUVWXYZabcdefgh

# ── MongoDB ─────────────────────────────────────────────
MONGODB_URI_PAYMENTS=mongodb+srv://USER:PASS@cluster.mongodb.net/payments
MONGODB_URI_MBOTS=mongodb+srv://USER:PASS@cluster.mongodb.net/mbot

# ── Redis ───────────────────────────────────────────────
# Desarrollo: redis://localhost:6379
# Producción: redis://:YOUR_REDIS_PASSWORD@your-redis-host:6379/0
REDIS_URL=redis://localhost:6379
REDIS_PASSWORD=

# ── API Security ────────────────────────────────────────
# Generar con: openssl rand -hex 32
EXTERNAL_API_KEY=GENERATE_WITH_openssl_rand_hex_32

# ── CORS / Network ──────────────────────────────────────
BASE_URL=https://yourdomain.com
ALLOWED_ORIGINS=https://yourdomain.com

# ── Bull Board (Dashboard de colas) ─────────────────────
# Habilitar para monitorear jobs activos/fallidos en /queues
BULL_BOARD_ENABLED=false
BULL_BOARD_USERNAME=admin
# Generar con: openssl rand -base64 24
BULL_BOARD_PASSWORD=
