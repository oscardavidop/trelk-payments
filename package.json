{
  "name": "tg-paypal-bot",
  "version": "1.0.0",
  "description": "Telegram Bot with PayPal Subscriptions Integration",
  "main": "dist/main.js",
  "scripts": {
    "dev": "nest start --watch",
    "build": "nest build",
    "start": "node dist/main.js",
    "start:worker": "node dist/worker.js",
    "dev:worker": "ts-node -r tsconfig-paths/register src/worker.ts",
    "typeorm": "typeorm",
    "gh": "git add . && git commit -m 'update' && git push",
    "nginx": "sudo cp ./scripts/webhook-dev.trelk.site /etc/nginx/sites-available/webhook-dev.trelk.site && sudo ln -sf /etc/nginx/sites-available/webhook-dev.trelk.site /etc/nginx/sites-enabled/webhook-dev.trelk.site && sudo systemctl restart nginx"
  },
  "dependencies": {
    "@nestjs/bullmq": "^11.0.4",
    "@nestjs/common": "^10.3.0",
    "@nestjs/config": "^4.0.4",
    "@nestjs/core": "^10.3.0",
    "@nestjs/mongoose": "^10.0.0",
    "@nestjs/platform-express": "^10.3.0",
    "@nestjs/schedule": "^6.1.3",
    "@nestjs/throttler": "^6.5.0",
    "@paypal/paypal-server-sdk": "^2.1.0",
    "@types/node": "^20.10.0",
    "axios": "^1.6.0",
    "bullmq": "^5.76.8",
    "class-transformer": "^0.5.1",
    "class-validator": "^0.15.1",
    "crypto": "^1.0.1",
    "dotenv": "^16.3.1",
    "helmet": "^8.1.0",
    "ioredis": "^5.10.1",
    "mongoose": "^8.0.0",
    "reflect-metadata": "^0.2.2",
    "rxjs": "^7.8.1",
    "telegraf": "^4.14.0"
  },
  "devDependencies": {
    "@nestjs/cli": "^10.3.0",
    "@types/debug": "^4.1.12",
    "@types/express": "^4.17.21",
    "ts-loader": "^9.5.1",
    "ts-node": "^10.9.1",
    "typescript": "^5.3.3"
  }
}
