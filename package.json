{
  "name": "tg-paypal-bot",
  "version": "1.0.0",
  "description": "Telegram Bot with PayPal Subscriptions Integration",
  "main": "dist/main.js",
  "scripts": {
    "build":             "nest build",

    "dev":               "nest start --watch",
    "dev:worker":        "ts-node -r tsconfig-paths/register src/worker.ts",
    "dev:all":           "concurrently --kill-others --prefix-colors \"cyan,yellow\" --names \"API,WORKER\" \"npm run dev\" \"npm run dev:worker\"",

    "start":             "node dist/main.js",
    "start:worker":      "node dist/worker.js",
    "start:prod":        "npm run build && concurrently --kill-others --names \"API,WORKER\" \"npm run start\" \"npm run start:worker\"",

    "pm2:start":         "pm2 start ecosystem.config.cjs",
    "pm2:stop":          "pm2 stop ecosystem.config.cjs",
    "pm2:restart":       "pm2 restart ecosystem.config.cjs",
    "pm2:reload":        "pm2 reload ecosystem.config.cjs",
    "pm2:delete":        "pm2 delete ecosystem.config.cjs",
    "pm2:logs":          "pm2 logs",
    "pm2:monit":         "pm2 monit",
    "pm2:save":          "pm2 save && pm2 startup",

    "docker:dev":        "docker compose -f docker-compose.dev.yml up",
    "docker:dev:build":  "docker compose -f docker-compose.dev.yml up --build",
    "docker:dev:down":   "docker compose -f docker-compose.dev.yml down -v",
    "docker:prod:build": "docker compose -f docker-compose.prod.yml build",
    "docker:prod:up":    "docker compose -f docker-compose.prod.yml up -d",
    "docker:prod:down":  "docker compose -f docker-compose.prod.yml down",

    "gh":                "git add . && git commit -m 'update' && git push",
    "nginx":             "sudo cp ./scripts/webhook-dev.trelk.site /etc/nginx/sites-available/webhook-dev.trelk.site && sudo ln -sf /etc/nginx/sites-available/webhook-dev.trelk.site /etc/nginx/sites-enabled/webhook-dev.trelk.site && sudo systemctl restart nginx"
  },
  "dependencies": {
    "@bull-board/api": "^7.1.5",
    "@bull-board/express": "^7.1.5",
    "@nestjs/bullmq": "^11.0.4",
    "@nestjs/common": "^10.3.0",
    "@nestjs/config": "^4.0.4",
    "@nestjs/core": "^10.3.0",
    "@nestjs/mongoose": "^10.0.0",
    "@nestjs/platform-express": "^10.3.0",
    "@nestjs/schedule": "^6.1.3",
    "@nestjs/throttler": "^6.5.0",
    "@paypal/paypal-server-sdk": "^2.1.0",
    "@types/node": "^20.10.0",
    "axios": "^1.6.0",
    "bullmq": "^5.76.8",
    "class-transformer": "^0.5.1",
    "class-validator": "^0.15.1",
    "concurrently": "^9.2.1",
    "crypto": "^1.0.1",
    "dotenv": "^16.3.1",
    "helmet": "^8.1.0",
    "ioredis": "^5.10.1",
    "mongoose": "^8.0.0",
    "reflect-metadata": "^0.2.2",
    "rxjs": "^7.8.1",
    "telegraf": "^4.14.0",
    "zod": "^4.4.3"
  },
  "devDependencies": {
    "@nestjs/cli": "^10.3.0",
    "@types/debug": "^4.1.12",
    "@types/express": "^4.17.21",
    "ts-loader": "^9.5.1",
    "ts-node": "^10.9.1",
    "typescript": "^5.3.3"
  }
}
